---
import GalleryViewer from "../../../components/GalleryViewer.astro";
import SiteHeader from "../../../components/SiteHeader.astro";
import ThemePlaceholder from "../../../components/ThemePlaceholder.astro";
import { loadGallery } from "../../../data/galleries";
import {
  chapters,
  copy,
  locales,
  type Chapter,
  type ChapterTheme,
  type Locale,
} from "../../../data/site";
import BaseLayout from "../../../layouts/BaseLayout.astro";

export function getStaticPaths() {
  return locales.flatMap((locale) =>
    chapters.flatMap((chapter) =>
      chapter.themes.map((theme) => ({
        params: { locale, chapter: chapter.slug, theme: theme.slug },
        props: { locale, chapter, theme },
      })),
    ),
  );
}

type Props = {
  locale: Locale;
  chapter: Chapter;
  theme: ChapterTheme;
};

const { locale, chapter, theme } = Astro.props;
const photos = await loadGallery(theme.slug);
const hasPhotos = photos.length > 0;
---

<BaseLayout
  locale={locale}
  currentChapter={chapter.slug}
  currentTheme={theme.slug}
  pageTitle={`${theme.label[locale]} · ${chapter.label[locale]}`}
  description={hasPhotos
    ? `${theme.label[locale]}。${copy[locale].description}`
    : `${theme.placeholderDescription[locale]} ${copy[locale].description}`}
>
  <div class:list={["page-shell", hasPhotos ? "page-shell--gallery" : "page-shell--theme"]}>
    <SiteHeader
      locale={locale}
      currentChapter={chapter.slug}
      currentTheme={theme.slug}
    />
    <main id="main-content" class:list={["chapter-main", hasPhotos && "gallery-main"]}>
      {hasPhotos ? (
        <GalleryViewer locale={locale} chapter={chapter} theme={theme} photos={photos} />
      ) : (
        <ThemePlaceholder locale={locale} chapter={chapter} theme={theme} />
      )}
    </main>
  </div>
</BaseLayout>
