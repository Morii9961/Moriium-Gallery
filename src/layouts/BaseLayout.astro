---
import { Font } from "astro:assets";
import {
  copy,
  htmlLanguages,
  locales,
  routeFor,
  siteTitle,
  type ChapterSlug,
  type Locale,
  type ThemeSlug,
} from "../data/site";
import "../styles/global.css";

type Props = {
  locale: Locale;
  description: string;
  pageTitle?: string;
  currentChapter?: ChapterSlug;
  currentTheme?: ThemeSlug;
};

const { locale, description, pageTitle, currentChapter, currentTheme } = Astro.props;
const title = pageTitle ? `${pageTitle} — ${siteTitle}` : siteTitle;
---

<!doctype html>
<html lang={htmlLanguages[locale]} data-theme="light" data-theme-preference="system">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#e9e3d6" data-theme-color />
    <title>{title}</title>
    {locales.map((alternateLocale) => (
      <link
        rel="alternate"
        hreflang={htmlLanguages[alternateLocale]}
        href={routeFor(alternateLocale, currentChapter, currentTheme)}
      />
    ))}
    <link
      rel="alternate"
      hreflang="x-default"
      href={routeFor("zh", currentChapter, currentTheme)}
    />
    <Font cssVariable="--font-title" preload />
    <script is:inline>
      (() => {
        const key = "moriium-theme";
        let preference = "system";
        try {
          const saved = localStorage.getItem(key);
          if (saved === "light" || saved === "dark" || saved === "system") preference = saved;
        } catch {}
        const dark = preference === "dark" ||
          (preference === "system" && window.matchMedia("(prefers-color-scheme: dark)").matches);
        document.documentElement.dataset.themePreference = preference;
        document.documentElement.dataset.theme = dark ? "dark" : "light";
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">{copy[locale].skipToContent}</a>
    <slot />
    <script>
      import "../scripts/site";
    </script>
  </body>
</html>
