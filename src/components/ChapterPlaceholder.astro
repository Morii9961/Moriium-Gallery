---
import { copy, routeFor, siteTitle, type Chapter, type Locale } from "../data/site";

type Props = {
  locale: Locale;
  chapter: Chapter;
};

const { locale, chapter } = Astro.props;
const t = copy[locale];
---

<section
  class="chapter-placeholder"
  style={`--placeholder: ${chapter.background}; --placeholder-dark: ${chapter.backgroundDark};`}
  aria-labelledby="chapter-title"
>
  <div class="chapter-placeholder__field" aria-hidden="true">
    <span>{chapter.number}</span>
    <span>{chapter.placeholderLabel[locale]}</span>
  </div>
  <div class="chapter-placeholder__content">
    <p lang="ja">{siteTitle}</p>
    <h1 id="chapter-title">{chapter.label[locale]}</h1>
    <p>{t.chapterPageDescription}</p>
    <a href={routeFor(locale)}>{t.backHome}<span aria-hidden="true">↗</span></a>
  </div>
</section>
