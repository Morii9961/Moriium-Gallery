---
import { Picture, getImage } from "astro:assets";
import "../styles/gallery.css";
import {
  copy,
  type Chapter,
  type ChapterTheme,
  type Locale,
} from "../data/site";
import type { ResolvedGalleryPhoto } from "../data/galleries";

type Props = {
  locale: Locale;
  chapter: Chapter;
  theme: ChapterTheme;
  photos: ResolvedGalleryPhoto[];
};

const { locale, chapter, theme, photos } = Astro.props;
const t = copy[locale];
const formatDate = new Intl.DateTimeFormat(
  locale === "zh" ? "zh-CN" : locale === "ja" ? "ja-JP" : "en",
  { year: "numeric", month: "long", day: "numeric", timeZone: "UTC" },
);

const preparedPhotos = await Promise.all(
  photos.map(async (photo) => {
    const detailWidth = photo.image.width;
    const [detailAvif, detailWebp, detailJpeg] = await Promise.all([
      getImage({ src: photo.image, width: detailWidth, format: "avif", quality: "high" }),
      getImage({ src: photo.image, width: detailWidth, format: "webp", quality: "high" }),
      getImage({ src: photo.image, width: detailWidth, format: "jpeg", quality: "high" }),
    ]);

    const metadata = [
      photo.title?.[locale] ? [t.title, photo.title[locale]] : null,
      photo.capturedOn
        ? [t.capturedOn, formatDate.format(new Date(`${photo.capturedOn}T00:00:00Z`))]
        : null,
      photo.camera ? [t.camera, photo.camera] : null,
      photo.lens ? [t.lens, photo.lens] : null,
      photo.focalLengthMm ? [t.focalLength, `${photo.focalLengthMm} mm`] : null,
      photo.aperture ? [t.aperture, `f/${photo.aperture}`] : null,
      photo.shutter ? [t.shutter, photo.shutter] : null,
      photo.iso ? [t.iso, String(photo.iso)] : null,
      photo.exposureCompensationEv
        ? [t.exposureCompensation, `${photo.exposureCompensationEv} EV`]
        : null,
    ].filter((row): row is [string, string] => row !== null);

    // Keep the full-resolution public derivative out of the initial responsive
    // set. It is exposed only through the deferred detail picture below.
    const viewerWidths = [
      ...new Set([640, 960, 1440, 1920, 2560, 3200, 3840, Math.min(3840, photo.image.width)]),
    ]
      .filter((width) => width <= photo.image.width)
      .sort((a, b) => a - b);
    const overviewWidths = [...new Set([240, 480, 720, 960, Math.min(960, photo.image.width)])]
      .filter((width) => width <= photo.image.width)
      .sort((a, b) => a - b);

    return {
      ...photo,
      detailAvif,
      detailWebp,
      detailJpeg,
      metadata,
      viewerWidths,
      overviewWidths,
      ratio: photo.image.width / photo.image.height,
    };
  }),
);
---

<section
  class="gallery"
  aria-labelledby="gallery-title"
  data-gallery
  data-active-index="0"
  data-view="single"
  data-photo-label={t.photograph}
  data-fit-label={t.fitPhoto}
  data-actual-label={t.viewActualSize}
  data-open-overview-label={t.openOverview}
  data-close-overview-label={t.closeOverview}
  data-open-info-label={t.photoInformation}
  data-close-info-label={t.closePhotoInformation}
>
  <div class="gallery__body">
    <div class="gallery__single" data-gallery-single>
      <header class="gallery-heading">
        <p>{chapter.label[locale]}</p>
        <h1 id="gallery-title">{theme.label[locale]}</h1>
      </header>

      <div class="gallery-stage" data-gallery-stage>
        {preparedPhotos.map((photo, index) => (
          <figure
            class="gallery-photo"
            data-gallery-photo
            data-photo-id={photo.id}
            data-photo-index={index}
            data-image-width={photo.image.width}
            data-image-height={photo.image.height}
            aria-label={`${index + 1} / ${preparedPhotos.length}`}
            aria-hidden={index === 0 ? "false" : "true"}
            hidden={index !== 0}
          >
            <Picture
              src={photo.image}
              formats={["avif", "webp"]}
              fallbackFormat="jpg"
              widths={photo.viewerWidths}
              sizes="100vw"
              alt={photo.alt[locale]}
              priority={index === 0}
              loading={index === 0 ? "eager" : "lazy"}
              draggable={false}
              class="gallery-photo__image"
              data-gallery-fit-image
              pictureAttributes={{ class: "gallery-photo__fit" }}
            />

            <picture class="gallery-photo__detail" data-gallery-detail hidden>
              <source type="image/avif" data-detail-srcset={photo.detailAvif.src} />
              <source type="image/webp" data-detail-srcset={photo.detailWebp.src} />
              <img
                alt={photo.alt[locale]}
                width={photo.image.width}
                height={photo.image.height}
                draggable="false"
                data-detail-src={photo.detailJpeg.src}
                data-gallery-detail-image
              />
            </picture>

            <p class="gallery-photo__error" data-gallery-image-error hidden>
              {t.imageUnavailable}
            </p>
          </figure>
        ))}
      </div>

      <aside
        class="gallery-info"
        id="gallery-information"
        aria-labelledby="gallery-information-title"
        data-gallery-info
        hidden
      >
        <div class="gallery-info__header">
          <h2 id="gallery-information-title">{t.photoInformation}</h2>
          <button type="button" data-gallery-info-close aria-label={t.closePhotoInformation}>
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="m6 6 12 12M18 6 6 18" />
            </svg>
          </button>
        </div>

        {preparedPhotos.map((photo, index) => (
          <div
            class="gallery-info__page"
            data-gallery-info-page
            data-photo-index={index}
            hidden={index !== 0}
          >
            <p class="gallery-info__index">
              {String(index + 1).padStart(2, "0")} / {String(preparedPhotos.length).padStart(2, "0")}
            </p>
            {photo.metadata.length > 0 ? (
              <dl>
                {photo.metadata.map(([label, value]) => (
                  <div>
                    <dt>{label}</dt>
                    <dd>{value}</dd>
                  </div>
                ))}
              </dl>
            ) : (
              <p class="gallery-info__empty">{photo.alt[locale]}</p>
            )}
          </div>
        ))}
      </aside>
    </div>

    <section
      class="gallery-overview"
      aria-labelledby="gallery-overview-title"
      data-gallery-overview
      hidden
    >
      <header class="gallery-overview__header">
        <div>
          <p>{chapter.label[locale]}</p>
          <h2 id="gallery-overview-title">{theme.label[locale]}</h2>
        </div>
        <p>{preparedPhotos.length} {t.photographs}</p>
      </header>

      <div class="gallery-overview__grid" role="list" data-gallery-overview-grid>
        {preparedPhotos.map((photo, index) => (
          <div
            class="gallery-overview__item"
            role="listitem"
            data-gallery-overview-item
            data-ratio={photo.ratio}
          >
            <button
              type="button"
              data-gallery-select={index}
              aria-label={`${t.photograph} ${index + 1}: ${photo.alt[locale]}`}
              aria-current={index === 0 ? "true" : undefined}
            >
              <Picture
                src={photo.image}
                formats={["avif", "webp"]}
                fallbackFormat="jpg"
                widths={photo.overviewWidths}
                sizes="(max-width: 640px) 50vw, (max-width: 1200px) 33vw, 25vw"
                alt=""
                loading="lazy"
                class="gallery-overview__image"
                pictureAttributes={{ class: "gallery-overview__picture" }}
              />
              <span aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
            </button>
          </div>
        ))}
      </div>
    </section>
  </div>

  <footer class="gallery-toolbar" aria-label={theme.label[locale]}>
    <div class="gallery-toolbar__paging">
      <button type="button" data-gallery-previous aria-label={t.previousPhoto}>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m15 6-6 6 6 6" /></svg>
      </button>
      <p class="gallery-toolbar__count" aria-hidden="true">
        <span data-gallery-current>01</span>
        <span>/</span>
        <span>{String(preparedPhotos.length).padStart(2, "0")}</span>
      </p>
      <button type="button" data-gallery-next aria-label={t.nextPhoto}>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 6 6 6-6 6" /></svg>
      </button>
    </div>

    <div class="gallery-toolbar__tools">
      <button
        type="button"
        data-gallery-overview-toggle
        aria-label={t.openOverview}
        aria-pressed="false"
      >
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M4 4h6v6H4zM14 4h6v6h-6zM4 14h6v6H4zM14 14h6v6h-6z" />
        </svg>
        <span data-gallery-overview-label>{t.openOverview}</span>
      </button>
      <button
        type="button"
        data-gallery-info-toggle
        aria-label={t.photoInformation}
        aria-controls="gallery-information"
        aria-expanded="false"
      >
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="12" cy="12" r="8" />
          <path d="M12 11v5M12 8h.01" />
        </svg>
        <span data-gallery-info-label>{t.photoInformation}</span>
      </button>
      <button
        type="button"
        data-gallery-zoom-toggle
        aria-label={t.viewActualSize}
        aria-pressed="false"
      >
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M9 4H4v5M15 4h5v5M20 15v5h-5M4 15v5h5" />
        </svg>
        <span data-gallery-zoom-label>{t.viewActualSize}</span>
      </button>
    </div>
  </footer>

  <p class="sr-only" aria-live="polite" aria-atomic="true" data-gallery-announcer></p>
</section>

<script>
  import "../scripts/gallery";
</script>
