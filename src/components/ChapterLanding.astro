---
import DeferredPicture from "./DeferredPicture.astro";
import CarouselControls from "./CarouselControls.astro";
import { galleries, loadGalleryPhoto, themeForPhoto } from "../data/galleries";
import { copy, routeFor, type Chapter, type Locale } from "../data/site";

type Props = {
  locale: Locale;
  chapter: Chapter;
};

const { locale, chapter } = Astro.props;
const t = copy[locale];
const previews = await Promise.all(
  chapter.previews.map(async (preview) => {
    const photo = preview.chapterPhotoId
      ? await loadGalleryPhoto(preview.chapterPhotoId)
      : undefined;
    const themeSlug = preview.chapterPhotoId ? themeForPhoto(preview.chapterPhotoId) : undefined;
    const theme = chapter.themes.find((item) => item.slug === themeSlug);
    const widths = photo
      ? [640, 1280, 1920, 2560, 3840]
          .filter((width) => width <= photo.image.width)
          .sort((a, b) => a - b)
      : [];
    return { ...preview, photo, theme, widths };
  }),
);
---

<section
  class="chapter-landing"
  aria-labelledby="chapter-title"
  aria-roledescription="carousel"
  data-locale={locale}
  data-carousel
  data-active-slide="0"
  data-cycle-state="running"
  data-cycle-duration="3000"
>
  <div class="chapter-landing__visual">
    <div class="chapter-landing__slides" aria-live="off">
      {previews.map((preview, index) => (
        <div
          class="chapter-landing__slide"
          data-carousel-slide
          data-slide-index={index}
          role="group"
          aria-label={`${index + 1} / ${previews.length}`}
          aria-hidden={index === 0 ? "false" : "true"}
          style={`--placeholder: ${preview.background}; --placeholder-dark: ${preview.backgroundDark}; --preview-position: ${preview.chapterPosition ?? "50% 50%"};`}
        >
          {preview.photo ? (
            <DeferredPicture
              deferred={index !== 0}
              src={preview.photo.image}
              formats={["webp"]}
              fallbackFormat="jpg"
              widths={preview.widths}
              sizes="(max-width: 760px) max(100vw, calc(62svh * 1.5)), 64vw"
              quality="high"
              alt={preview.photo.alt[locale]}
              priority={index === 0}
              loading="eager"
              draggable={false}
              class="chapter-landing__image"
              pictureAttributes={{ class: "chapter-landing__picture" }}
            />
          ) : (
            <p class="chapter-landing__caption">{t.photographPending}</p>
          )}
          {preview.photo && preview.theme && (
            <p class="chapter-landing__caption">{preview.theme.label[locale]}</p>
          )}
        </div>
      ))}
    </div>
    <div class="chapter-landing__shade" aria-hidden="true"></div>
    <CarouselControls locale={locale} />
  </div>

  <div class="chapter-landing__content">
    <h1 id="chapter-title">{chapter.label[locale]}</h1>

    <div class="chapter-landing__index">
      <nav class="theme-directory" aria-label={t.chapterThemes}>
        {chapter.themes.map((theme) => (
          <a href={routeFor(locale, chapter.slug, theme.slug)}>
            <span class="theme-directory__label">{theme.label[locale]}</span>
            <span class="theme-directory__leader" aria-hidden="true"></span>
            <span class="theme-directory__count">
              {galleries[theme.slug].length}
              <span>{t.photoUnit}</span>
            </span>
          </a>
        ))}
      </nav>

      <a class="chapter-landing__back" href={routeFor(locale)}>
        <span aria-hidden="true">←</span>
        {t.backHome}
      </a>
    </div>
  </div>
</section>
