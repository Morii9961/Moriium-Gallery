---
import { Picture } from "astro:assets";
import CarouselControls from "./CarouselControls.astro";
import { loadGalleryPhoto } from "../data/galleries";
import { copy, routeFor, siteTitle, type Chapter, type Locale } from "../data/site";

type Props = {
  locale: Locale;
  chapter: Chapter;
};

const { locale, chapter } = Astro.props;
const t = copy[locale];
const previews = await Promise.all(
  chapter.previews.map(async (preview) => {
    const photo = preview.chapterPhotoId
      ? await loadGalleryPhoto(preview.chapterPhotoId)
      : undefined;
    const widths = photo
      ? [...new Set([480, 720, 960, 1440, 1920, 2560, 3200, 3840])]
          .filter((width) => width <= photo.image.width)
          .sort((a, b) => a - b)
      : [];
    return { ...preview, photo, widths };
  }),
);
---

<section
  class="chapter-landing"
  aria-labelledby="chapter-title"
  aria-roledescription="carousel"
  data-carousel
  data-active-slide="0"
  data-cycle-state="running"
  data-cycle-duration="3000"
>
  <div class="chapter-landing__visual">
    <div class="chapter-landing__slides" aria-live="off">
      {previews.map((preview, index) => (
        <div
          class="chapter-landing__slide"
          data-carousel-slide
          data-slide-index={index}
          role="group"
          aria-label={`${index + 1} / ${previews.length}`}
          aria-hidden={index === 0 ? "false" : "true"}
          style={`--placeholder: ${preview.background}; --placeholder-dark: ${preview.backgroundDark}; --preview-position: ${preview.chapterPosition ?? "50% 50%"};`}
        >
          {preview.photo && (
            <Picture
              src={preview.photo.image}
              formats={["avif", "webp"]}
              fallbackFormat="jpg"
              widths={preview.widths}
              sizes="(max-width: 760px) 100vw, 42vw"
              quality="high"
              alt={preview.photo.alt[locale]}
              priority={index === 0}
              loading={index === 0 ? "eager" : "lazy"}
              draggable={false}
              class="chapter-landing__image"
              pictureAttributes={{ class: "chapter-landing__picture" }}
            />
          )}
        </div>
      ))}
    </div>

    <div class="chapter-landing__frame" aria-hidden="true"></div>
    <p class="chapter-landing__number" aria-hidden="true">{chapter.number}</p>
    <p class="chapter-landing__place" aria-hidden="true">{chapter.placeholderLabel[locale]}</p>
    <p class="chapter-landing__pending">
      {!previews[0].photo && <>{t.photographPending}<span aria-hidden="true"> · </span></>}
      <span data-chapter-frame-number>01</span> / 03
    </p>
    <CarouselControls locale={locale} />
  </div>

  <div class="chapter-landing__content">
    <p lang="ja">{siteTitle}</p>
    <h1 id="chapter-title">{chapter.label[locale]}</h1>

    <nav class="theme-directory" aria-label={t.chapterThemes}>
      {chapter.themes.map((theme) => (
        <a href={routeFor(locale, chapter.slug, theme.slug)}>
          <span class="theme-directory__number">{theme.number}</span>
          <span class="theme-directory__label">{theme.label[locale]}</span>
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M7 17 17 7M9 7h8v8" />
          </svg>
        </a>
      ))}
    </nav>

    <a class="chapter-landing__back" href={routeFor(locale)}>
      {t.backHome}
      <span aria-hidden="true">↗</span>
    </a>
  </div>
</section>
